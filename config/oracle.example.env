# Acqua Orbit DC - exemplo de configuracao Oracle opcional
#
# No PowerShell, configure assim antes de rodar o script:
# $env:ORACLE_USER="seu_usuario"
# $env:ORACLE_PASSWORD="sua_senha"
# $env:ORACLE_DSN="localhost:1521/XEPDB1"
#
# Se essas variaveis nao forem configuradas, o projeto usa fallback em CSV.

ORACLE_USER=seu_usuario
ORACLE_PASSWORD=sua_senha
ORACLE_DSN=localhost:1521/XEPDB1
